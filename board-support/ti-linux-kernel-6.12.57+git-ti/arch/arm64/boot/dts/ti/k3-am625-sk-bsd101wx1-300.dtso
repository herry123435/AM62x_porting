/*
 * Bestar BSD101WX1-300 panel overlay for AM625 SK / CX-AM62x.
 *
 * ===== CRZ CHANGED: restored DUAL-LINK OLDI (board evidence) =====
 * Bring-up showed single-link OLDI0 reaches an active CRTC + lit backlight
 * but a black panel. The old working 6.1 port muxed ALL eight OLDI pairs
 * (A0..A7) plus both clocks and used a dual-link odd/even overlay, so the
 * panel consumes both channels. If this shows a garbled image instead,
 * flip to CLONE mode (keep ti,companion-oldi, drop ti,secondary-oldi and
 * the dual-lvds-*-pixels properties) - that serves a single-link panel
 * wired to the second channel. Keep drivers/video/tidss in U-Boot set to
 * OLDI_DUAL_LINK in sync with this file.
 */
/dts-v1/;
/plugin/;

&{/} {
	display {
		compatible = "bestar,bsd101wx1-300", "panel-simple";
		backlight = <&lcd_bl>;
		width-mm = <154>;
		height-mm = <86>;
		data-mapping = "vesa-24";

		panel-timing {
			clock-frequency = <72400>;
			hactive = <1280>;
			vactive = <800>;
			hfront-porch = <68>;
			hback-porch = <2>;
			hsync-len = <60>;
			vfront-porch = <8>;
			vback-porch = <2>;
			vsync-len = <8>;
			de-active = <1>;
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dual-lvds-odd-pixels;
				lcd_in0: endpoint {
					remote-endpoint = <&oldi_0_out>;
				};
			};

			port@1 {
				reg = <1>;
				dual-lvds-even-pixels;
				lcd_in1: endpoint {
					remote-endpoint = <&oldi_1_out>;
				};
			};
		};
	};
};

&dss {
	status = "okay";
};

&oldi0 {
	status = "okay";
	ti,companion-oldi = <&oldi1>;
};

&oldi1 {
	status = "okay";
	ti,secondary-oldi;
	ti,companion-oldi = <&oldi0>;
};

&oldi0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		oldi_0_in: endpoint {
			remote-endpoint = <&dpi0_out0>;
		};
	};

	port@1 {
		reg = <1>;
		oldi_0_out: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};

&oldi1_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		oldi_1_in: endpoint {
			remote-endpoint = <&dpi0_out1>;
		};
	};

	port@1 {
		reg = <1>;
		oldi_1_out: endpoint {
			remote-endpoint = <&lcd_in1>;
		};
	};
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		dpi0_out0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&oldi_0_in>;
		};

		dpi0_out1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&oldi_1_in>;
		};
	};
};
