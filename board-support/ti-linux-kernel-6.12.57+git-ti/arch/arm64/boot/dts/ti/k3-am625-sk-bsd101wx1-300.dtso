/*
 * Bestar BSD101WX1-300 panel overlay for AM625 SK / CX-AM62x.
 *
 * ===== CRZ CHANGED: rewritten as SINGLE-link OLDI =====
 * A 10.1" 1280x800 @ 72.4 MHz LVDS panel is a single-channel panel (cf. the
 * in-tree rocktech,rk101ii01d-ct of the same class); the previous dual-link
 * (odd/even pixels on OLDI0+OLDI1) routing cannot light it up. Single link
 * is selected in tidss_oldi.c simply by NOT having ti,companion-oldi.
 * Timings, size and bus format come from the panel-simple descriptor
 * ("bestar,bsd101wx1-300"); a panel-timing node here would only trigger
 * "Reject override mode" warnings, so it is intentionally absent.
 * The panel must be wired to OLDI0_A0..A3 + OLDI0_CLK0 (odd channel of J6).
 */

/dts-v1/;
/plugin/;

&{/} {
	display {
		compatible = "bestar,bsd101wx1-300", "panel-simple";
		backlight = <&lcd_bl>;

		port {
			lcd_in0: endpoint {
				remote-endpoint = <&oldi_0_out>;
			};
		};
	};
};

&dss {
	status = "okay";
};

&oldi0 {
	status = "okay";
	/* no ti,companion-oldi => single-link OLDI */
};

&oldi0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		oldi_0_in: endpoint {
			remote-endpoint = <&dpi0_out0>;
		};
	};

	port@1 {
		reg = <1>;
		oldi_0_out: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		dpi0_out0: endpoint {
			remote-endpoint = <&oldi_0_in>;
		};
	};
};
