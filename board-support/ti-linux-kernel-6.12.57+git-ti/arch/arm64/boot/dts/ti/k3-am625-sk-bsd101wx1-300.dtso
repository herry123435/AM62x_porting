// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Bestar BSD101WX1-300 panel + touch overlay for AM625 SK / CX-AM62x.
 *
 * ===== CRZ CHANGED (4th revision): DPI panel on VP2 + touch =====
 * This 10.1" 1280x800 touchscreen connects via the 60-pin RGB FPCB (CX
 * schematic sheet 4 "LCD I/F (RGB)", J5): 24-bit parallel RGB from
 * VOUT0_DATA0..23 plus the touch lines. It is NOT on the LVDS connector
 * (J6); board proof: the working 6.1 system exposes it as "DPI-1".
 * dss_ports port@1 is VP2 = DPI out (the base k3-am625-sk.dts deletes the
 * SK HDMI consumer of this port, so the overlay re-creates it).
 *
 * Faithfully ported from the old 6.1 overlay (decompiled from the working
 * eMMC system):
 *  - enable-gpios GPIO0_36 = LCD_PWREN (panel power, NOT backlight-enable)
 *  - capacitive touch: edt-ft5306 on main_i2c1 @0x38,
 *      INT  = GPMC0_WPn  pad 0x0a4 -> GPIO0_40 (TS_INT_N)
 *      RST  = GPMC0_CLK  pad 0x07c -> GPIO0_31 (TS_RST_N)
 *      (the base dts removes the SK-only vdd_sd_dv regulator that vanilla
 *       puts on pad 0x07c)
 *  - resistive touch: tsc2007 on main_i2c1 @0x4a (declared like the old
 *    overlay; probes away cleanly when not fitted)
 * Timings come from the panel-simple "bestar,bsd101wx1-300" descriptor.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "k3-pinctrl.h"

&{/} {
	display {
		compatible = "bestar,bsd101wx1-300", "panel-simple";
		backlight = <&lcd_bl>;
		enable-gpios = <&main_gpio0 36 GPIO_ACTIVE_HIGH>;	/* LCD_PWREN */

		port {
			lcd_in0: endpoint {
				remote-endpoint = <&dpi1_out>;
			};
		};
	};
};

&dss {
	status = "okay";
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@1 {
		reg = <1>;
		dpi1_out: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};

&main_pmx0 {
	mango_ts_pins_default: mango-ts-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0a4, PIN_INPUT, 7)  /* (N20) GPMC0_WPn.GPIO0_40  TS_INT_N */
			AM62X_IOPAD(0x07c, PIN_OUTPUT, 7) /* (P25) GPMC0_CLK.GPIO0_31  TS_RST_N */
		>;
	};
};

&main_i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	touchscreen_ts2007: tsc2007@4a {
		compatible = "ti,tsc2007";
		reg = <0x4a>;
		gpios = <&main_gpio0 40 GPIO_ACTIVE_LOW>;
		ti,x-plate-ohms = <660>;
		linux,wakeup;
	};

	touchscreen_ft5306: edt-ft5306@38 {
		status = "okay";
		compatible = "edt,edt-ft5306", "edt,edt-ft5x06";
		pinctrl-names = "default";
		pinctrl-0 = <&mango_ts_pins_default>;
		reg = <0x38>;
		interrupt-parent = <&main_gpio0>;
		interrupts = <40 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&main_gpio0 31 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <800>;
		wakeup-source;
	};
};
