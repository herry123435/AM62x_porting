/*
 * Bestar BSD101WX1-300 panel overlay for AM625 SK / CX-AM62x.
 *
 * ===== CRZ CHANGED (3rd revision): DPI panel on VP2 =====
 * This 10.1" 1280x800 touchscreen connects via the 60-pin RGB FPCB (CX
 * schematic sheet 4 "LCD I/F (RGB)", J5): 24-bit parallel RGB from
 * VOUT0_DATA0..23 plus the capacitive-touch lines. It is NOT on the LVDS
 * connector (J6). Board proof: the working 6.1 system exposes it as
 * connector "DPI-1". dss_ports port@1 is VP2 = DPI out (the base
 * k3-am625-sk.dts deletes the SK HDMI consumer of this port, so the
 * overlay re-creates it). Earlier revisions wrongly drove the OLDI
 * transmitters (single- and dual-link) - always black, since nothing is
 * wired there for this panel.
 * Timings come from the panel-simple "bestar,bsd101wx1-300" descriptor.
 * TODO (from old 6.1 dtbo): capacitive touch node (edt-ft5x06, main_i2c1
 * addr 0x38) and LCD_PWREN handling.
 */

/dts-v1/;
/plugin/;

&{/} {
	display {
		compatible = "bestar,bsd101wx1-300", "panel-simple";
		backlight = <&lcd_bl>;

		port {
			lcd_in0: endpoint {
				remote-endpoint = <&dpi1_out>;
			};
		};
	};
};

&dss {
	status = "okay";
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@1 {
		reg = <1>;
		dpi1_out: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};
