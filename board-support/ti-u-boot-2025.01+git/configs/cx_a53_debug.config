# ===== CRZ TEMPORARY DIAGNOSTIC fragment - do NOT ship =====
# Apply on top of the defconfig to make silent early-boot failures visible:
#   make am62x_evm_a53_defconfig cx_am62x_a53_min.config cx_a53_debug.config O=...
# 1) DEBUG_UART: printf/puts fall back to raw UART0 before the console is up
#    (covers U-Boot proper pre-banner crashes); also prints <debug_uart> marker.
# 2) LOG + SPL_LOG at debug level: debug() breadcrumbs in spl_mmc/spl_fit/fat
#    print on the SPL console (covers the silent FAT/FIT window).
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_OMAP=y
CONFIG_DEBUG_UART_BASE=0x02800000
CONFIG_DEBUG_UART_CLOCK=48000000
CONFIG_DEBUG_UART_BAUDRATE=115200
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_LOG=y
CONFIG_LOG_MAX_LEVEL=7
CONFIG_LOG_DEFAULT_LEVEL=7
CONFIG_SPL_LOG=y
CONFIG_SPL_LOG_MAX_LEVEL=7
