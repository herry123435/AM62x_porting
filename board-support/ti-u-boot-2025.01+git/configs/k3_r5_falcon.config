# ===== CRZ TUNED for CX-AM62x (mango) START =====
# K3 R5-SPL Falcon fragment, applied ONLY to the Falcon R5 build via:
#   export UBOOT_CFG_CORTEXR="${UBOOT_CFG_CORTEXR} k3_r5_falcon.config"
# It is merged on top of (and overrides) the board's customized
# am62x_evm_r5_defconfig. The normal R5/A53 build never includes this file, so
# the normal tiboot3.bin/tispl.bin/U-Boot chain is byte-for-byte unchanged.
#
# Falcon target on this board: SD card (DM3AT, MMC1), ext4 rootfs partition 2,
# files /boot/tifalcon.bin + /boot/fitImage (see board/ti/am62x/am62x.env:
# mmcdev=1, bootpart=1:2). For SD boot the ROM sets the boot device to MMC1 and
# the R5 SPL FS-loads from it, so no MMC device index is hardcoded here.
#
# NAND is intentionally NOT a Falcon source: K3 ROM/SPL Falcon supports SD/eMMC
# FS-boot only. NAND booting keeps using the normal chain (this fragment is a
# separate build, so it cannot affect it).
#
# Activation is still gated at runtime by spl_start_uboot() (board/ti/am62x/evm.c):
# Falcon is taken only when env 'boot_os=yes' (default 'no'); a 'c' on the
# console always forces the full U-Boot chain. SPL_OS_BOOT_SECURE=y below
# disables SPL_FALCON_ALLOW_FALLBACK, so that gate is the only safety net.
# ===== CRZ TUNED for CX-AM62x (mango) END =====

# Enable falcon mode
CONFIG_SPL_OS_BOOT=y
CONFIG_SPL_OS_BOOT_SECURE=y

# We use envs for setting bootargs
CONFIG_SPL_ENV_SUPPORT=y

# Allows for the SPL to detect UUID for kernel's rootfs
CONFIG_SPL_PARTITION_UUIDS=y

# Perform FDT fixups from SPL
CONFIG_OF_SYSTEM_SETUP=y

# We use the rootfs (i.e partition 2) for booting which is ext4 not FAT
CONFIG_SYS_MMCSD_FS_BOOT=y
CONFIG_SYS_MMCSD_FS_BOOT_PARTITION=2
CONFIG_SPL_FS_EXT4=y

# Loading tifalcon instead of tispl which has FDT and A53 SPL saves time
CONFIG_SPL_FS_LOAD_PAYLOAD_NAME="boot/tifalcon.bin"
CONFIG_SPL_FS_LOAD_KERNEL_NAME="boot/fitImage"
CONFIG_SPL_LOAD_FIT=y

# Used as the 2MiB aligned load address for kernel
# CRZ: kernel 0x82000000 / DTB 0x88000000 / DM 0x89000000 all fit this board's
# 1GB DDR4 (0x80000000-0xC0000000) and match TI's SK map - no change needed.
CONFIG_SYS_LOAD_ADDR=0x82000000
CONFIG_SPL_STACK_R_ADDR=0x88000000
CONFIG_SPL_LOAD_FIT_ADDRESS=0x82000000
CONFIG_SPL_PAYLOAD_ARGS_ADDR=0x88000000
CONFIG_SPL_STACK_R_MALLOC_SIMPLE_LEN=0x2700000

# Disable all unsupported boot media to save space.
# CRZ: each line below intentionally OVERRIDES the CX-AM62x am62x_evm_r5_defconfig
# (which enables NAND/eMMC-boot/RAW/FAT for the normal chain) for the Falcon
# variant only. SD/MMC1 ext4-p2 FS-boot needs none of them. To later add an
# eMMC (MMC0) Falcon path, re-enable CONFIG_SUPPORT_EMMC_BOOT here.
# CONFIG_SPL_SYS_MMCSD_RAW_MODE is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_YMODEM_SUPPORT is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_SPL_NAND_SUPPORT is not set
# CRZ: on CX-AM62x the base am62x_evm_r5_defconfig enables the full GPMC raw-NAND
# stack. NAND_OMAP_GPMC builds omap_gpmc.o and (on ARCH_K3) force-selects
# SPL_NAND_INIT, whose raw loaders use SYS_NAND_BLOCK_SIZE. Disabling only
# SPL_NAND_SUPPORT removes SYS_NAND_BLOCK_SIZE but leaves omap_gpmc.c compiling
# -> "CONFIG_SYS_NAND_BLOCK_SIZE undeclared". Falcon is SD-only, so disable the
# whole raw-NAND stack here (MTD_RAW_NAND cascades NAND_OMAP_GPMC/ELM off).
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_NAND_OMAP_GPMC is not set
# CONFIG_NAND_OMAP_ELM is not set
# CONFIG_SPL_NOR_SUPPORT is not set
# CONFIG_SPL_RAM_DEVICE is not set
# CONFIG_SPL_FS_FAT is not set
