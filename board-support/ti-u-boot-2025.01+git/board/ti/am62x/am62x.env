#include <env/ti/ti_common.env>
#include <env/ti/mmc.env>
#include <env/ti/k3_dfu.env>
#include <env/ti/ospi_nand.env>

/* ===== CRZ ADDED START: GPMC NAND boot env (init_nand/get_kern_nand/...) ===== */
#if CONFIG_MTD_RAW_NAND
#include <env/ti/nand.env>
#endif
/* ===== CRZ ADDED END ===== */

#if CONFIG_CMD_REMOTEPROC
#include <env/ti/k3_rproc.env>
#endif

rproc_fw_binaries= 0 /lib/firmware/am62-mcu-m4f0_0-fw

/* ===== CRZ ADDED START: LCD panel overlay selection =====
 * dtbo_idx: 0 = no overlay, 1 = innolux-at070tn92 (RGB),
 *           2 = innolux-m236hjj-l31 (LVDS), 3 = bsd101wx1-300 (LVDS)
 * NOTE: must NOT live inside findfdt - board_late_init()/ti_set_fdt_env()
 * overwrites both fdtfile and findfdt on every boot. bootcmd runs
 * set_overlays instead; get_overlay_${boot} then applies ${name_overlays}.
 */
dtbo_idx=3
set_overlays=
	if test ${dtbo_idx} = 1; then
		setenv name_overlays ti/k3-am625-sk-innolux-at070tn92.dtbo; fi;
	if test ${dtbo_idx} = 2; then
		setenv name_overlays ti/k3-am625-sk-innolux-m236hjj-l31.dtbo; fi;
	if test ${dtbo_idx} = 3; then
		setenv name_overlays ti/k3-am625-sk-bsd101wx1-300.dtbo; fi
/* ===== CRZ ADDED END ===== */

name_kern=Image
console=ttyS2,115200n8
args_all=setenv optargs ${optargs} earlycon=ns16550a,mmio32,0x02800000
	${mtdparts}
run_kern=booti ${loadaddr} ${rd_spec} ${fdtaddr}

boot_targets=mmc1 mmc0 usb pxe dhcp
boot=mmc
mmcdev=1
bootpart=1:2
bootdir=/boot
rd_spec=-

/* CRZ ADDED START: Falcon mode (R5 SPL direct Linux boot) - opt-in, default OFF.
 * Read by spl_start_uboot() in board/ti/am62x/evm.c ONLY in a Falcon build
 * (configs/k3_r5_falcon.config). Set 'boot_os=yes' (and place tifalcon.bin +
 * boot/fitImage on rootfs partition 2) to take the fast path; any other value
 * boots the normal tispl.bin -> A53 SPL -> U-Boot chain. */
boot_os=no
/* CRZ ADDED END */

splashfile=ti_logo_414x97_32bpp.bmp.gz
splashimage=0x80200000
splashpos=m,m
splashsource=mmc

/* CRZ ADDED START: splash display */
loadsplash=ls mmc 1;
	fatload mmc 1 $loadaddr ti_logo_414x97_32bpp.bmp.gz;
	bmp info $loadaddr;
	bmp display $loadaddr m m;
/* CRZ ADDED END */

#if CONFIG_BOOTMETH_ANDROID
#include <env/ti/android.env>
adtb_idx=0
get_adtb_idx=
	if test ${board_name} = am62x_lp_skevm; then
		setenv adtb_idx 1;
	else
		setenv adtb_idx 0;
	fi;
bootcmd=run get_adtb_idx; bootflow scan -lb
#endif
